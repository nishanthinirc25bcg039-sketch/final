# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URI (postgresql://user:pass@host:5432/db)
# Required on serverless hosts like Vercel (also reads POSTGRES_URL / SUPABASE_DB_URL).
# When unset locally, SmartStock AI persists data in local SQLite (./data/smartstock.db).
DATABASE_URL=""

# SESSION_SECRET: Secret key used to sign session tokens across serverless instances.
# Generate a random 32+ character string for production deployments.
SESSION_SECRET=""
