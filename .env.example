# GEMINI_API_KEY: Required for live Gemini AI Insights and Inventory Assistant.
# AI Studio automatically injects this at runtime from user secrets,
# or configure it via Settings > Secrets / server environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Long random string (>= 32 chars) used to sign session tokens.
# Set this in production so user sessions persist across server restarts.
SESSION_SECRET="CHANGE_ME_TO_A_32_PLUS_CHAR_RANDOM_SECRET"

# DATABASE_PATH: Optional filesystem path to the persistent SQLite database file.
# Defaults to ./data/smartstock.db
DATABASE_PATH="./data/smartstock.db"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"
